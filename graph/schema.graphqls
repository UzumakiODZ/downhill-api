scalar DateTime

type User {
  id: ID!
  username: String!
  email: String!
  regID: String!
  password: String!

  posts: [Post!]!
}

type Company {
  id: ID!
  companyName: String!
  
  roles: [Role!]!
  questions: [QuestionBank!]!
}

type Role {
  id: ID!
  roleName: String
  year: Int
  companyId: ID!
  company: Company!
  offerType: String
  cgpa: Float
  other: String
  ctc: Float
  base: Float
  hired: Int
  converted: Int
}

type QuestionBank {
  id: ID!
  question: String
  companyId: ID!
  company: Company!
  years: Int
}

type Post {
  id: ID!
  title: String
  content: String
  userId: ID!
  
  user: User!
  createdAt: DateTime
  
  comments: [Comment!]!
}

type AuthPayload {
  token: String!
  user: User!
}

input CreateUserInput{
  email: String!
  regId: String!
  password: String!
}

input LoginInput{
  username: String!
  password: String!
}

input CreateCompanyInput {
  companyName: String!
}

input CreateRoleInput {
  roleName: String
  year: Int
  companyId: ID!
  offerType: String
  cgpa: Float
  other: String
  ctc: Float
  base: Float
}

input CreateQuestionInput {
  question: String
  companyId: ID!
  years: Int
}

input CreatePostInput {
  title: String
  content: String
  companyId: ID!
  userId: ID!
}

input CreateCommentInput {
  content: String!
  postId: ID!
  userId: ID!
}

type Query {

  getAllCompanies: [Company!]!
  getCompanyByID(companyId: ID!): Company!
  
  getRolesByCompany(companyId: ID!): [Role!]!
  getQuestionsByCompany(companyId: ID!): [QuestionBank!]!

  getPost(id: ID!): Post
  getAllPosts: [Post!]!

  getCommentsByPost(postId: ID!): [Comment!]!
}

type Mutation {

  createUser(input: CreateUserInput!): AuthPayload!
  Login(input: LoginInput!): Boolean!
  Logout: Boolean!
  createCompany(input: CreateCompanyInput!): Company!
  createRole(input: CreateRoleInput!): Role!
  createQuestion(input: CreateQuestionInput!): QuestionBank!
  createPost(input: CreatePostInput!): Post!

  deletePost(id: ID!): Boolean!

  createComment(input: CreateCommentInput!): Comment!
  deleteComment(id: ID!): Boolean!
}

type Comment {
  id: ID!
  content: String
  postId: ID!
  post: Post!
  userId: ID!
  user: User!
  createdAt: DateTime
}

